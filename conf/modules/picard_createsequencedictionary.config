process {
    withName: PICARD_CREATESEQUENCEDICTIONARY {
        ext.args = ""
        ext.prefix = { fasta.baseName }  // genome.fa -> genome
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/reference_genome" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference,
            pattern: "*.dict"
        ]
    }
}
